<Window x:Class="OrdersSystemSql.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OrdersSystemSql"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Title="MainWindow" Height="500" Width="500">
    <Grid>
        <StackPanel x:Name="BtnsConyainer"
                    Width="300"
                    Margin="10"
                    VerticalAlignment="Center">
            <Button Content="Добавить клиента"
                    Click="AddNewCustomer_Click"
                    Margin="10"/>
            <Button Content="Добавить товар"
                    Click="AddNewProduct_Click"
                    Margin="10"/>
            <Button Content="Создать заказ"
                    Click="CreateNewOrder_Click"
                    Margin="10"/>
            <Button Content="Смотреть список заказов"
                    Click="ViewAllOrders_Click"
                    Margin="10"/>
        </StackPanel>
    </Grid>
</Window>
