<Window x:Class="OrdersSystemSql.ViewAllOrders"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OrdersSystemSql"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Title="ViewAllOrders" Height="450" Width="700">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="BtnsContainer"
                    Margin="10"
                    Grid.Row="0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
            <Button Content="Go Back" Click="Back_Click" Width="100"/>
        </StackPanel>
        
        <DataGrid x:Name="AllOrdersInfo" 
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  Background="Transparent"
                  BorderThickness="0">

            <DataGrid.Resources>
                <Style TargetType="TextBlock" x:Key="ElementStyle">
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="TextAlignment" Value="Center"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                </Style>

                <Style TargetType="DataGridRow">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="MinHeight" Value="45"/>
                    <Setter Property="Background" Value="#40FFFFFF"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridRow">
                                <Border x:Name="RowBorder" 
                                        Background="{TemplateBinding Background}" 
                                        BorderBrush="#4087CEEB" 
                                        BorderThickness="1"    
                                        CornerRadius="6"       
                                        Margin="2"       
                                        SnapsToDevicePixels="True">

                                    <SelectiveScrollingGrid>
                                        <SelectiveScrollingGrid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </SelectiveScrollingGrid.ColumnDefinitions>

                                        <DataGridCellsPresenter Grid.Column="1" 
                                                                ItemsPanel="{TemplateBinding ItemsPanel}" 
                                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </SelectiveScrollingGrid>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="RowBorder" Property="Background" Value="#60FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="RowBorder" Property="Background" Value="#8087CEEB"/>
                                        <Setter TargetName="RowBorder" Property="BorderBrush" Value="#FF87CEEB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" 
                                 Value="True">
                            <Setter Property="Foreground" 
                                    Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            
            <DataGrid.Columns>
                <DataGridTextColumn Header="Order" 
                                    Binding="{Binding OrderId}" 
                                    Width="*" 
                                    ElementStyle="{StaticResource ElementStyle}"/>
                <DataGridTextColumn Header="Customer" 
                                    Binding="{Binding CustomerId}" 
                                    Width="*" 
                                    ElementStyle="{StaticResource ElementStyle}"/>
                <DataGridTextColumn Header="Date Create" 
                                    Binding="{Binding CreatedAt, StringFormat=\{0:dd.MM.yyyy\}}" 
                                    Width="*" 
                                    ElementStyle="{StaticResource ElementStyle}"/>
                <DataGridTextColumn Header="Status" 
                                    Binding="{Binding Status}" 
                                    Width="*" 
                                    ElementStyle="{StaticResource ElementStyle}"/>
                <DataGridTextColumn Header="Consists" 
                                    Binding="{Binding ProductsList}" 
                                    Width="*" 
                                    ElementStyle="{StaticResource ElementStyle}"/>
                <DataGridTextColumn Header="Amount" 
                                    Binding="{Binding TotalPrice}" 
                                    Width="*" 
                                    ElementStyle="{StaticResource ElementStyle}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
