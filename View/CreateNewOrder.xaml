<Window x:Class="OrdersSystemSql.CreateNewOrder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Title="CreateNewOrder"
        Height="500"
        Width="500">

    <Grid>
        <StackPanel Width="300"
                    Margin="10"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <TextBlock Text="Choose Customer:"
                       HorizontalAlignment="Center"/>

            <ComboBox ItemsSource="{Binding Customers}"
                      SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                      DisplayMemberPath="Name"/>

            <TextBlock Text="Order Items:"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>

            <ListView ItemsSource="{Binding CurrentOrderItems}"
                      SelectedItem="{Binding SelectedOrderItem, Mode=TwoWay}"
                      Height="100">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Product.Name}"
                                       FontWeight="Bold"
                                       Margin="0,0,5,0"/>

                            <TextBlock Text="{Binding Quantity, StringFormat='(x{0})'}"
                                       Foreground="Gray"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button Content="Add Item"
                        Command="{Binding AddItemCommand}"
                        Width="80"
                        Height="25"
                        Margin="5"/>

                <Button Content="Delete Item"
                        Command="{Binding DeleteItemCommand}"
                        Width="90"
                        Height="25"
                        Margin="5"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,10">

                <TextBlock Text="Total:"
                           Width="50"
                           TextAlignment="Center"/>

                <TextBox Width="150"
                         Text="{Binding TotalPrice, Mode=OneWay}"
                         IsReadOnly="True"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button Content="Go Back"
                        Command="{Binding BackCommand}"
                        Width="100"
                        Height="30"
                        Margin="10"/>

                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Width="100"
                        Height="30"
                        Margin="10"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>