<Window x:Class="OrdersSystemSql.AddNewCustomer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OrdersSystemSql"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="AddNewCustomer" Height="500" Width="500">
    <Grid>
        <StackPanel x:Name="CustomerInfoContainer"
                    Width="300"
                    Margin="10"
                    VerticalAlignment="Center">
            <TextBlock Text="Customer Name:"
                       HorizontalAlignment="Center"/>
            <TextBox x:Name="CustomerName_Value"
                     Text="{Binding Name, 
                UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Customer Email:"
                       HorizontalAlignment="Center"/>
            <TextBox x:Name="CustomerEmail_Value"
                     Text="{Binding Email, 
                UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Customer Phone:"
                       HorizontalAlignment="Center"/>
            <TextBox x:Name="CustomerPhone_Value"
                     Text="{Binding Phone, 
                UpdateSourceTrigger=PropertyChanged}"/>

            
            <StackPanel x:Name="BtnsInfo"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button Content="Go Back"
                        Command="{Binding BackCommand}"
                        Width="100"
                        Height="30"
                        FontSize="15"
                        Margin="10"/>
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Width="100"
                        Height="30"
                        FontSize="15"
                        Margin="10"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
